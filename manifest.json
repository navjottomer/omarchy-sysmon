{
  "schemaVersion": 1,
  "id": "navjottomer.sysmon",
  "name": "System monitor",
  "version": "1.2.0",
  "author": "navjottomer",
  "license": "MIT",
  "description": "CPU, memory, GPU, disk and network at a glance, with warnings, history graphs, top processes and a shortcut to btop",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "System monitor",
    "description": "CPU, memory, GPU, disk and network at a glance",
    "category": "System",
    "allowMultiple": false,
    "defaults": {
      "barLayout": "stacked",
      "barTop": "cpu",
      "barBottom": "disk",
      "barNetwork": true,
      "warnTemp": 85,
      "warnUsage": 90
    },
    "schema": [
      {
        "key": "barLayout",
        "type": "enum",
        "label": "Bar layout",
        "options": [
          "stacked",
          "line",
          "compact"
        ],
        "defaultValue": "stacked"
      },
      {
        "key": "barTop",
        "type": "enum",
        "label": "Bar top row",
        "options": [
          "cpu",
          "memory",
          "gpu",
          "disk",
          "temperature"
        ],
        "defaultValue": "cpu"
      },
      {
        "key": "barBottom",
        "type": "enum",
        "label": "Bar bottom row",
        "options": [
          "cpu",
          "memory",
          "gpu",
          "disk",
          "temperature"
        ],
        "defaultValue": "disk"
      },
      {
        "key": "barNetwork",
        "type": "boolean",
        "label": "Show network speed on the bar",
        "defaultValue": true
      },
      {
        "key": "warnTemp",
        "type": "integer",
        "label": "Warn at CPU or GPU temperature (°C)",
        "min": 50,
        "max": 110,
        "step": 1,
        "defaultValue": 85
      },
      {
        "key": "warnUsage",
        "type": "integer",
        "label": "Warn at memory or disk use (%)",
        "min": 50,
        "max": 100,
        "step": 1,
        "defaultValue": 90
      }
    ]
  }
}
