#!/usr/bin/env bash
# Streams one JSON object per line every INTERVAL seconds: raw numbers for the
# panel to format, lay out and put on the bar itself.
# Consumed by Panel.qml in this plugin.
#
# Everything on the hot path reads /proc or /sys and writes through `printf -v`,
# so a steady-state tick forks nothing at all — no `$( )` subshells, no external
# binaries, not even `sleep`: the wait between ticks is a timed read on stdin.
# The only exception is `df` (every df_every seconds).
#
# The panel writes one word per line on stdin:
#   open   the panel is on screen: also sample processes and the NVIDIA GPU
#   close  the panel is gone: stop both (the GPU after gpu_linger seconds)
# Stdin closing means the panel is gone for good, so the script exits.
#
# Options: --gpu-always keeps the NVIDIA GPU sampled with the panel closed,
# for when the bar itself shows the GPU.

interval=2
df_every=30    # seconds between df runs
gpu_linger=60  # seconds nvidia-smi keeps running after the panel closes

gpu_always=0
[[ ${1:-} == --gpu-always ]] && gpu_always=1

# Bounds on what one record can carry, so the shell never buffers an
# unbounded line: at most this many list entries, names clipped to this many
# characters, and the whole record capped at max_record characters (lists are
# dropped from a record that would exceed it).
max_mounts=16 max_ifaces=16 max_gpus=8 max_name=64 max_drives=8 max_top=5
max_record=32768

now_us() { # wall clock in microseconds, into $now_out, without forking
  local t=$EPOCHREALTIME
  now_out=$((10#${t//[!0-9]/}))
}

jstr() { # JSON-escape $1 into $jstr_out
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\v'/\\u000b}
  s=${s//$'\t'/\\t}
  s=${s//$'\n'/\\n}
  jstr_out="\"$s\""
}

clip() { # $1 clipped to $2 characters, into $clip_out
  clip_out=${1:0:$2}
}

rate() { # bytes-per-second -> at most 4 characters, into $rate_out
  local b=$1
  if ((b < 1024)); then
    printf -v rate_out '%dB' "$b"
  elif ((b < 1024 * 1024)); then
    printf -v rate_out '%dK' $((b / 1024))
  elif ((b < 10 * 1024 * 1024)); then
    printf -v rate_out '%d.%dM' $((b / 1048576)) $(((b % 1048576) * 10 / 1048576))
  elif ((b < 1024 * 1024 * 1024)); then
    printf -v rate_out '%dM' $((b / 1048576))
  else
    printf -v rate_out '%d.%dG' $((b / 1073741824)) $(((b % 1073741824) * 10 / 1073741824))
  fi
}

# ---------------------------------------------------------------- cpu

# Locate a CPU temperature input once, if this machine exposes one.
tempfile=""
for hw in /sys/class/hwmon/hwmon*; do
  [[ -r $hw/name ]] || continue
  case "$(<"$hw/name")" in
    k10temp | zenpower | coretemp)
      for f in "$hw"/temp*_input; do
        [[ -r $f ]] && tempfile=$f && break
      done
      ;;
  esac
  [[ -n $tempfile ]] && break
done

cpu_prev_idle=0 cpu_prev_total=0
cpu_pct=0 cpu_temp="" ncpu=0
declare -a core_prev_idle=() core_prev_total=()
cores=""

# One pass over /proc/stat covers the aggregate and every core, so the per-core
# breakdown the panel draws costs nothing beyond the read already being done.
sample_cpu() {
  local name user nice sys idle iowait irq softirq steal idle_all total
  local d_total d_idle pct i=0 millideg
  cores=""

  while read -r name user nice sys idle iowait irq softirq steal _; do
    [[ $name == cpu* ]] || break
    idle_all=$((idle + iowait))
    total=$((user + nice + sys + idle + iowait + irq + softirq + steal))

    if [[ $name == cpu ]]; then
      d_total=$((total - cpu_prev_total))
      d_idle=$((idle_all - cpu_prev_idle))
      cpu_prev_total=$total cpu_prev_idle=$idle_all
      ((d_total > 0)) && cpu_pct=$(((100 * (d_total - d_idle) + d_total / 2) / d_total)) || cpu_pct=0
      continue
    fi

    d_total=$((total - ${core_prev_total[i]:-total}))
    d_idle=$((idle_all - ${core_prev_idle[i]:-idle_all}))
    core_prev_total[i]=$total core_prev_idle[i]=$idle_all
    ((d_total > 0)) && pct=$(((100 * (d_total - d_idle) + d_total / 2) / d_total)) || pct=0
    cores+="${cores:+,}$pct"
    i=$((i + 1))
  done < /proc/stat

  ncpu=$i

  cpu_temp=""
  if [[ -n $tempfile ]]; then
    read -r millideg < "$tempfile"
    cpu_temp=$((millideg / 1000))
  fi
}

# ---------------------------------------------------------------- memory

mem_used=0 mem_total=0 mem_pct=0
swap_used=0 swap_total=0 swap_pct=0

# MemAvailable is the kernel's own estimate of what a new workload could claim,
# which is what "used" should be measured against — MemFree alone would count
# every reclaimable cache page as used and read alarmingly high.
sample_mem() {
  local key val total=0 avail=0 stotal=0 sfree=0
  while read -r key val _; do
    case $key in
      MemTotal:) total=$val ;;
      MemAvailable:) avail=$val ;;
      SwapTotal:) stotal=$val ;;
      SwapFree:)
        sfree=$val
        break # last field of interest; skip the rest of the file
        ;;
    esac
  done < /proc/meminfo

  mem_total=$((total * 1024))
  mem_used=$(((total - avail) * 1024))
  ((total > 0)) && mem_pct=$(((100 * (total - avail) + total / 2) / total)) || mem_pct=0

  swap_total=$((stotal * 1024))
  swap_used=$(((stotal - sfree) * 1024))
  ((stotal > 0)) && swap_pct=$(((100 * (stotal - sfree) + stotal / 2) / stotal)) || swap_pct=0
}

# ---------------------------------------------------------------- network

# Overlay interfaces (VPN, containers, bridges) carry traffic that is already
# counted on the physical link underneath, so counting them would double up.
skip_iface() {
  case $1 in
    lo | veth* | docker* | br-* | virbr* | tailscale* | tun* | tap* | wg* | vmnet* | vboxnet* | ifb*) return 0 ;;
  esac
  return 1
}

declare -A net_prev_rx net_prev_tx
net_rx=0 net_tx=0 net_ifaces=""

sample_net() {
  local line name rx tx d_rx d_tx live=0 entry
  local -A seen=()
  net_rx=0 net_tx=0 net_ifaces=""

  while IFS= read -r line; do
    [[ $line == *:* ]] || continue
    name=${line%%:*}
    name=${name// /}
    skip_iface "$name" && continue

    read -r rx _ _ _ _ _ _ _ tx _ <<<"${line#*:}"
    [[ $rx =~ ^[0-9]+$ && $tx =~ ^[0-9]+$ ]] || continue

    seen[$name]=1
    d_rx=$((rx - ${net_prev_rx[$name]:-rx}))
    d_tx=$((tx - ${net_prev_tx[$name]:-tx}))
    net_prev_rx[$name]=$rx net_prev_tx[$name]=$tx
    ((d_rx < 0)) && d_rx=0 # counter reset on link flap
    ((d_tx < 0)) && d_tx=0

    d_rx=$((d_rx * 1000000 / dt_us)) d_tx=$((d_tx * 1000000 / dt_us))
    net_rx=$((net_rx + d_rx)) net_tx=$((net_tx + d_tx))

    if ((rx > 0 || tx > 0)); then
      live=$((live + 1))
      ((live > max_ifaces)) && continue
      clip "$name" "$max_name"
      jstr "$clip_out"
      printf -v entry '{"name":%s,"rx":%d,"tx":%d}' "$jstr_out" "$d_rx" "$d_tx"
      net_ifaces+="${net_ifaces:+,}$entry"
    fi
  done < /proc/net/dev

  # Forget interfaces that are gone, so short-lived ones (USB tethering,
  # hotplugged adapters) cannot pile up over a long session.
  for name in "${!net_prev_rx[@]}"; do
    [[ -n ${seen[$name]:-} ]] || unset 'net_prev_rx[$name]' 'net_prev_tx[$name]'
  done

  # A single active link makes the per-interface breakdown a repeat of the
  # totals, so only keep it once there is more than one link to compare.
  ((live > 1)) || net_ifaces=""
}

# ---------------------------------------------------------------- disk

# Whole disks only — partitions and dm/loop/zram devices would double-count the
# same physical I/O.
physical() {
  case $1 in
    nvme[0-9]*n[0-9] | sd[a-z] | sd[a-z][a-z] | vd[a-z] | hd[a-z] | mmcblk[0-9]) return 0 ;;
  esac
  return 1
}

disk_prev_r=0 disk_prev_w=0
disk_r=0 disk_w=0 root_pct=0 mounts=""

sample_disk_io() {
  local sect_r=0 sect_w=0 name f6 f10 cur_r cur_w
  while read -r _ _ name _ _ f6 _ _ _ f10 _; do
    physical "$name" || continue
    sect_r=$((sect_r + f6)) sect_w=$((sect_w + f10))
  done < /proc/diskstats

  cur_r=$((sect_r * 512)) cur_w=$((sect_w * 512))
  disk_r=$(((cur_r - disk_prev_r) * 1000000 / dt_us))
  disk_w=$(((cur_w - disk_prev_w) * 1000000 / dt_us))
  disk_prev_r=$cur_r disk_prev_w=$cur_w
  ((disk_r < 0)) && disk_r=0
  ((disk_w < 0)) && disk_w=0
}

refresh_df() {
  local -A seen=()
  local source target used size pcent entry jt ju js
  mounts="" root_pct=0
  # Btrfs subvolumes all report the same filesystem, so list each backing
  # device once — shortest mountpoint wins, which is the one worth naming.
  while read -r source target used size pcent; do
    [[ -n ${seen[$source]} ]] && continue
    seen[$source]=1
    ((${#seen[@]} > max_mounts)) && continue
    pcent=${pcent//[^0-9]/}
    [[ $target == / ]] && root_pct=$((10#0$pcent))
    clip "$target" "$max_name"; jstr "$clip_out"; jt=$jstr_out
    clip "$used" 16; jstr "$clip_out"; ju=$jstr_out
    clip "$size" 16; jstr "$clip_out"; js=$jstr_out
    printf -v entry '{"target":%s,"used":%s,"size":%s,"pct":%d}' \
      "$jt" "$ju" "$js" "$((10#0$pcent))"
    mounts+="${mounts:+,}$entry"
  done < <(df -h --output=source,target,used,size,pcent \
    -x tmpfs -x devtmpfs -x efivarfs -x squashfs -x overlay -x fuse.portal 2>/dev/null |
    tail -n +2 | awk '{ print length($2), $0 }' | sort -n -k1,1 -k3,3 | cut -d" " -f2-)
}

# NVMe drives report their own temperature and the limit they are rated for,
# as plain hwmon files. Found once at startup.
declare -a drive_temp=() drive_json=()
for h in /sys/class/nvme/nvme*/hwmon*; do
  [[ -r $h/temp1_input ]] || continue
  ((${#drive_temp[@]} < max_drives)) || break
  ctrl=${h%/hwmon*}
  model=""
  [[ -r $ctrl/model ]] && read -r model < "$ctrl/model"
  model=${model%"${model##*[![:space:]]}"}
  [[ -n $model ]] || model=${ctrl##*/}
  max=null
  [[ -r $h/temp1_max ]] && read -r max < "$h/temp1_max" && max=$((max / 1000))
  ((max > 0)) 2>/dev/null || max=null
  clip "${model//_/ }" "$max_name"; jstr "$clip_out"
  drive_temp+=("$h/temp1_input")
  drive_json+=("{\"name\":$jstr_out,\"max\":$max,\"temp\":")
done

drives=""
sample_drives() {
  local i t
  drives=""
  for i in "${!drive_temp[@]}"; do
    t=null
    read -r t 2>/dev/null < "${drive_temp[i]}" && [[ $t =~ ^-?[0-9]+$ ]] && t=$((t / 1000)) || t=null
    drives+="${drives:+,}${drive_json[i]}$t}"
  done
}

# ---------------------------------------------------------------- gpu

# AMD cards expose load, VRAM and sensors as plain sysfs files, so they cost
# a few reads per tick. Found once at startup.
declare -a amd_dev=() amd_hwmon=()
for card in /sys/class/drm/card[0-9]; do
  [[ -r $card/device/vendor && -r $card/device/gpu_busy_percent ]] || continue
  [[ $(<"$card/device/vendor") == 0x1002 ]] || continue
  ((${#amd_dev[@]} < max_gpus)) || break
  amd_dev+=("$card/device")
  hw=""
  for h in "$card"/device/hwmon/hwmon*; do [[ -d $h ]] && hw=$h && break; done
  amd_hwmon+=("$hw")
done

# NVIDIA has no sysfs counters; nvidia-smi's own loop mode (-lms) keeps one
# long-lived process that prints a CSV line per GPU each interval. The loop
# below only drains whatever it has written, so a tick still forks nothing.
# It only runs while something shows the GPU (the open panel, or the bar with
# --gpu-always), so a closed panel costs no nvidia-smi process at all. If it
# dies (driver reload) while wanted, it is restarted every 30 ticks.
nv_lines=() nv_restart=0 nv_wanted=$gpu_always nv_stop_at=0
nvsmi=""
for d in /usr/bin /bin /opt/bin; do [[ -x $d/nvidia-smi ]] && nvsmi=$d/nvidia-smi && break; done
start_nvsmi() {
  [[ -n $nvsmi ]] || return
  [[ -n ${NVSMI_PID:-} ]] && kill -0 "$NVSMI_PID" 2>/dev/null && return
  coproc NVSMI {
    exec "$nvsmi" --query-gpu=index,name,utilization.gpu,memory.used,memory.total,temperature.gpu,power.draw \
      --format=csv,noheader,nounits -lms $((interval * 1000)) 2>/dev/null
  }
}
stop_nvsmi() {
  [[ -n ${NVSMI_PID:-} ]] && kill "$NVSMI_PID" 2>/dev/null
  wait "${NVSMI_PID:-}" 2>/dev/null
  unset NVSMI_PID
  nv_lines=()
}
((nv_wanted)) && start_nvsmi
trap stop_nvsmi EXIT
trap 'exit 0' TERM INT HUP

gpus=""

# Keep the newest line per GPU index; older lines queued since the last tick
# are simply overwritten.
drain_nvsmi() {
  local line idx
  if ((!nv_wanted)); then
    # Linger a while after the panel closes, so quickly reopening it does not
    # pay for a fresh nvidia-smi start each time.
    if [[ -n ${NVSMI_PID:-} ]] && ((now_out >= nv_stop_at)); then stop_nvsmi; fi
    [[ -n ${NVSMI_PID:-} ]] || return
  fi
  if [[ -z ${NVSMI_PID:-} ]] || ! kill -0 "$NVSMI_PID" 2>/dev/null; then
    nv_lines=()
    if ((nv_restart++ % 30 == 0)); then start_nvsmi; fi
    return
  fi
  while read -r -t 0 -u "${NVSMI[0]}" 2>/dev/null; do
    IFS= read -r -u "${NVSMI[0]}" line || break
    ((${#line} <= 512)) || continue
    idx=${line%%,*}
    [[ $idx =~ ^[0-9]+$ ]] && ((idx < max_gpus)) && nv_lines[idx]=$line
  done
}

num_or_null() { # $1 -> integer text, or null when not a number
  [[ $1 =~ ^[0-9]+(\.[0-9]+)?$ ]] && num_out=${1%%.*} || num_out=null
}

sample_gpu() {
  local line idx name util mused mtotal temp power entry i busy vused vtotal t pw jn
  gpus=""
  drain_nvsmi
  for line in "${nv_lines[@]}"; do
    IFS=',' read -r idx name util mused mtotal temp power <<<"$line"
    name=${name# } name=${name#NVIDIA } name=${name#GeForce }
    clip "$name" "$max_name"
    jstr "$clip_out"; jn=$jstr_out
    num_or_null "${util// /}"; util=$num_out
    num_or_null "${mused// /}"; mused=$num_out
    num_or_null "${mtotal// /}"; mtotal=$num_out
    num_or_null "${temp// /}"; temp=$num_out
    num_or_null "${power// /}"; power=$num_out
    [[ $mused != null ]] && mused=$((mused * 1048576))
    [[ $mtotal != null ]] && mtotal=$((mtotal * 1048576))
    printf -v entry '{"name":%s,"pct":%s,"memUsed":%s,"memTotal":%s,"temp":%s,"power":%s}' \
      "$jn" "$util" "$mused" "$mtotal" "$temp" "$power"
    gpus+="${gpus:+,}$entry"
  done
  for i in "${!amd_dev[@]}"; do
    busy=null vused=null vtotal=null t=null pw=null
    read -r busy 2>/dev/null < "${amd_dev[i]}/gpu_busy_percent"
    read -r vused 2>/dev/null < "${amd_dev[i]}/mem_info_vram_used"
    read -r vtotal 2>/dev/null < "${amd_dev[i]}/mem_info_vram_total"
    if [[ -n ${amd_hwmon[i]} ]]; then
      read -r t 2>/dev/null < "${amd_hwmon[i]}/temp1_input" && t=$((t / 1000))
      read -r pw 2>/dev/null < "${amd_hwmon[i]}/power1_input" && pw=$((pw / 1000000))
    fi
    num_or_null "$busy"; busy=$num_out
    num_or_null "$vused"; vused=$num_out
    num_or_null "$vtotal"; vtotal=$num_out
    num_or_null "$t"; t=$num_out
    num_or_null "$pw"; pw=$num_out
    printf -v entry '{"name":"Radeon Graphics","pct":%s,"memUsed":%s,"memTotal":%s,"temp":%s,"power":%s}' \
      "$busy" "$vused" "$vtotal" "$t" "$pw"
    gpus+="${gpus:+,}$entry"
  done
}

# ---------------------------------------------------------------- processes

# Only while the panel is open: one pass over /proc/<pid>/stat per tick, which
# costs a few milliseconds and would be wasted on a closed panel. CPU is
# measured like top, as a share of one thread (so 250% is 2.5 threads busy).
procs_on=0
declare -A proc_a=() proc_b=() proc_name=()
proc_flip=0
top_cpu="" top_mem=""
hz=100 page=4096

# Keep the $max_top largest values seen so far in two parallel arrays,
# largest first, without forking sort. $3 is the pid the value belongs to.
top_insert() { # $1 array-name prefix, $2 value, $3 pid
  local -n tv=$1_v tp=$1_p
  local i n=${#tv[@]}
  ((n >= max_top && $2 <= tv[n - 1])) && return
  for ((i = 0; i < n; i++)); do (($2 > tv[i])) && break; done
  tv=("${tv[@]:0:i}" "$2" "${tv[@]:i}")
  tp=("${tp[@]:0:i}" "$3" "${tp[@]:i}")
  if ((${#tv[@]} > max_top)); then
    tv=("${tv[@]:0:max_top}")
    tp=("${tp[@]:0:max_top}")
  fi
}

top_json() { # $1 array-name prefix, $2 value key, into $top_out
  local -n tv=$1_v tp=$1_p
  local i entry
  top_out=""
  for i in "${!tp[@]}"; do
    clip "${proc_name[${tp[i]}]}" 32; jstr "$clip_out"
    printf -v entry '{"name":%s,"%s":%d}' "$jstr_out" "$2" "${tv[i]}"
    top_out+="${top_out:+,}$entry"
  done
}

reset_procs() {
  proc_a=() proc_b=() proc_name=()
}

sample_procs() {
  local f line pid ticks rss prev d
  local -a tc_v=() tc_p=() tm_v=() tm_p=()
  # Two tables take turns as this pass and the previous one, so nothing
  # is copied between ticks.
  if ((proc_flip ^= 1)); then
    local -n cur=proc_a old=proc_b
  else
    local -n cur=proc_b old=proc_a
  fi
  cur=() proc_name=()
  for f in /proc/[0-9]*/stat; do
    read -r line 2>/dev/null < "$f" || continue
    pid=${line%% *}
    # After the name, split on spaces: state is field 3, utime 14, stime 15,
    # rss 24. Those fields are plain numbers and one letter, so no globbing.
    set -- ${line##*) }
    ticks=$((${12} + ${13}))
    rss=$((${22} * page))
    cur[$pid]=$ticks
    ((rss > 0)) || continue # kernel threads
    prev=${old[$pid]:-}
    if [[ -n $prev ]]; then
      d=$(((ticks - prev) * 100000000 / (hz * dt_us)))
      ((d > 0)) && top_insert tc "$d" "$pid"
    fi
    top_insert tm "$rss" "$pid"
  done
  for pid in "${tc_p[@]}" "${tm_p[@]}"; do
    [[ -n ${proc_name[$pid]:-} ]] && continue
    read -r line 2>/dev/null < "/proc/$pid/stat" || line="$pid (?) "
    line=${line#*(}
    proc_name[$pid]=${line%)*}
  done
  top_json tc pct; top_cpu=$top_out
  top_json tm mem; top_mem=$top_out
}

# ---------------------------------------------------------------- loop

first=1
uptime_s=0
now_us; last_us=$now_out
next_df_us=0
wait_us=400000 # the first real tick comes soon after the baseline sample

while :; do
  now_us
  dt_us=$((now_out - last_us))
  ((dt_us > 0)) || dt_us=1
  last_us=$now_out

  sample_cpu
  sample_mem
  sample_net
  sample_disk_io
  sample_drives
  sample_gpu
  if ((procs_on)); then sample_procs; else top_cpu="" top_mem=""; fi
  if ((now_out >= next_df_us)); then
    refresh_df
    next_df_us=$((now_out + df_every * 1000000))
  fi

  read -r uptime_s _ < /proc/uptime
  uptime_s=${uptime_s%%.*}
  read -r load1 load5 load15 _ < /proc/loadavg

  if ((first)); then
    # The first deltas are measured against boot, so throw them away and take a
    # quick second sample instead of showing an all-time average.
    first=0
  else
    jstr "$load1 $load5 $load15"; jload=$jstr_out
    fmt='{"uptime":%d,"cpu":{"pct":%d,"temp":%s,"load":%s,"threads":%d,"cores":[%s]},"mem":{"used":%d,"total":%d,"pct":%d,"swapUsed":%d,"swapTotal":%d,"swapPct":%d},"net":{"rx":%d,"tx":%d,"ifaces":[%s]},"disk":{"pct":%d,"read":%d,"write":%d,"mounts":[%s],"drives":[%s]},"gpus":[%s],"top":{"cpu":[%s],"mem":[%s]}}'
    printf -v record "$fmt" \
      "$uptime_s" \
      "$cpu_pct" "${cpu_temp:-null}" "$jload" "$ncpu" "$cores" \
      "$mem_used" "$mem_total" "$mem_pct" "$swap_used" "$swap_total" "$swap_pct" \
      "$net_rx" "$net_tx" "$net_ifaces" \
      "$root_pct" "$disk_r" "$disk_w" "$mounts" "$drives" "$gpus" "$top_cpu" "$top_mem"
    if ((${#record} > max_record)); then
      # Too big to send whole: keep the numbers, drop the lists.
      printf -v record "$fmt" \
        "$uptime_s" \
        "$cpu_pct" "${cpu_temp:-null}" "$jload" "$ncpu" "" \
        "$mem_used" "$mem_total" "$mem_pct" "$swap_used" "$swap_total" "$swap_pct" \
        "$net_rx" "$net_tx" "" \
        "$root_pct" "$disk_r" "$disk_w" "" "" "" "" ""
    fi
    printf '%s\n' "$record"
  fi

  # Wait for the next tick on stdin instead of forking `sleep`. A command
  # from the panel ends the wait early; end of input means the panel is gone.
  deadline_us=$((last_us + wait_us))
  wait_us=$((interval * 1000000))
  while :; do
    now_us
    left_us=$((deadline_us - now_out))
    ((left_us > 0)) || break
    printf -v left '%d.%06d' $((left_us / 1000000)) $((left_us % 1000000))
    if IFS= read -r -t "$left" -n 16 cmd; then
      case $cmd in
        open)
          procs_on=1 nv_wanted=1
          start_nvsmi
          # Take a baseline for the process list and tick again shortly.
          ((${#proc_a[@]} + ${#proc_b[@]})) || { dt_us=1000000; sample_procs; }
          deadline_us=$((now_out + 500000))
          ;;
        close)
          procs_on=0 nv_wanted=$gpu_always
          reset_procs
          nv_stop_at=$((now_out + gpu_linger * 1000000))
          ;;
      esac
    elif (($? <= 128)); then
      exit 0 # stdin closed: the panel went away
    fi
  done
done
